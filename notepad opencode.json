{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python -m pytest*": "allow",
      "python -m compileall*": "allow",
      "ruff check*": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "ssh*": "deny",
      "scp*": "deny",
      "sudo*": "deny"
    },
    "external_directory": "deny"
  }
}