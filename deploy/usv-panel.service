[Unit]
Description=USV camera control panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/usv-release-e8d15fb
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/recorder/venv-pyav14/bin/python /root/usv-release-e8d15fb/control_panel.py --host 0.0.0.0 --port 8099 --device-left /dev/video2 --device-right /dev/video4 --output-root /root/recordings --record-seconds 0
Restart=no
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=30
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
